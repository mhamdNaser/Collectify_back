# The host serves this folder (public_html) directly. Send every request to Laravel's
# public/ folder so the API works and project files (artisan, composer.json, config...) are never served.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
